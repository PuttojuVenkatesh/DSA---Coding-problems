class Solution {
public:
    int search(vector<int>& nums, int target) {
       int low1=0,  high=nums.size()-1;
       while(low1<=high){
        int mid=(low1+high)/2;
        if(nums[mid]==target){
            return mid;
        }
       if(nums[low1]<=nums[mid]){
        if(target>=nums[low1] && target<=nums[mid]){
            high=mid-1;
        }
        else{
            low1=mid+1;
        }
       }
       else{
        if(target>=nums[mid] && target<=nums[high]){
            low1=mid+1;
        }
        else{
            high=mid-1;
        }
       }
      
       }
       
       return -1;
    }
};
