#include <bits/stdc++.h>
using namespace std;
 
int main()
{
   int t; cin>>t;
   while(t--){
       int n;  cin>>n;
       long long a[n];
         for(int i=0;i<n;i++){
            cin>>a[i];
         }
         int cnt1=0, cnt2=0;
        for(int i=0;i<n;i++){
         if(a[i]%2==0){
            cnt1++;
         }
        }
 
        for(int i=0;i<n;i++){
         if(a[i]%2!=0){
            cnt2++;
         }
        }
 
        if(cnt1==n || cnt2==n){
         for(int i=0;i<n;i++){
            cout<<a[i]<<" ";
         }
         cout<<endl;
        }
        else{
         sort(a, a+n);
         for(int i=0;i<n;i++){
            cout<<a[i]<<" ";
         }
         cout<<endl;
        }
   }
   return 0;
}
