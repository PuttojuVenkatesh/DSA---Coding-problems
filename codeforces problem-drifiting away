#include <bits/stdc++.h>
using namespace std;
 
int main() {
    int t;   cin>>t;
    while(t--){
        
          string s; cin>>s;
          int n=s.size();
          int c1=0,c2=0,c3=0;
             for(int i=0;i<n;i++){
              if(s[i]=='<'){
                c1++;
              }
              if(s[i]=='*'){
                c2++;
              }
              if(s[i]=='>'){
                c3++;
              }
             }
 
             string chck=string(c1,'<') + string(c2,'*') + string(c3,'>');
             if(c2>1 || chck!=s){
              cout<<"-1"<<endl;
             }
             else{
              cout<<max(c1+c2,c2+c3)<<endl;
             }
    }
        return 0;
}
