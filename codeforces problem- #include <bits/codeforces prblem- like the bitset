#include <bits/stdc++.h>
using namespace std;
 
int main()
{
    int t;   cin>>t;
    while(t--){
      int n, k;   cin>>n>>k;
      string s;   cin>>s;
      int x[n];
      for(int i=1;i<=s.size();i++){
        x[i]=s[i]-'0';
      }
      int cnt1=0, cnt2=0;
    for(int i=0;i<n;i++){
      if(x[i]==0){
         cnt1++;
      }
      else{
        cnt2++;
      }
    }
    if(cnt1>=cnt2){
      cout<<"YES"<<endl;
      for(int i=1;i<=n;i++){
        cout<<i<<" ";
      }
      cout<<endl;
    }
    else{
      cout<<"NO"<<endl;
    }
 
 
    }
    
 
}
