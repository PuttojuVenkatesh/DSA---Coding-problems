#include <bits/stdc++.h>
using namespace std;
 
int main() {
     int t; cin>>t;
      while(t--){
         int n;   cin>>n;
         int a[n];
         for(int i=0;i<n;i++)  {   
         cin>>a[i];
         }
       int ans=-1;
       for(int i=2;i<n;i++){
        if(min(a[i-1],a[i-2])<=a[i] && a[i]<=max(a[i-1],a[i-2])){
            ans=1;
        }
       }
       for(int i=0;i<n-2;i++){
        if(min(a[i+1],a[i+2])<=a[i] && a[i]<=max(a[i+1],a[i+2])){
            ans=1;
        }
       }
       for(int i=0;i<n-1;i++){
        if(abs(a[i]-a[i+1])<=1){
            ans=0;
        }
       }
       cout<<ans<<endl;
     }
        return 0;
}
