#include <bits/stdc++.h>
using namespace std;
 
int main(){
  int t;  cin>>t;
   while(t--){
      int n,k;   cin>>n>>k;
       int zer=0, one=0;
     for(int i=0;i<n;i++){
      char c;  cin>>c;
      if(c=='0')  zer++;
      else    one++;
     }
      int up=(n-2*k)/2;
      
         if(zer>=up && one>=up && (zer-up)%2==0 && (one-up)%2==0)
         {
          cout<<"YES"<<endl;
         }
         else{
          cout<<"NO"<<endl;
         }
   }
   }
