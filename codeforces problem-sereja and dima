#include <bits/stdc++.h>
using namespace std;
 
int main() {
   int n;  cin>>n;
   int a[n];
   for(int i=0;i<n;i++){
    cin>>a[i];
   }
 
  bool flag=true;
  int se=0,di=0;
  int left=0, right=n-1;
  while(left<=right){
    int ans=0;
    if(a[left]>=a[right]){
         ans=a[left];
         left++;
    }
    else{
        ans=a[right];
        right--;
    }
    if(flag){
        se+=ans;
        flag=false;
    }
    else{
        di+=ans;
        flag=true;
    }
  }
  cout<<se<<" "<<di<<endl;
 
    
 
    return 0;
}
