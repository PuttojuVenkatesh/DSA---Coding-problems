#include <bits/stdc++.h>
using namespace std;
 
int main() {
    int t;
    cin >> t;
 
    while (t--) {
        vector<string> board(8);
        for (int i = 0; i < 8; i++) {
            cin >> board[i];
        }
 
        bool redWins = false;
 
        
        for (int i = 0; i < 8; i++) {
            bool allR = true;
            for (int j = 0; j < 8; j++) {
                if (board[i][j] != 'R') {
                    allR = false;
                    break;
                }
            }
            if (allR) {
                redWins = true;
                break;
            }
        }
 
        if (redWins)
            cout << "R\n";
        else
            cout << "B\n";
    }
 
    return 0;
}
