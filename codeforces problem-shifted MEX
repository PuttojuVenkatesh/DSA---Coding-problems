#include <bits/stdc++.h>
using namespace std;
 
int main() {
    int t;   cin>>t;
    while(t--){
      long long n;   cin>>n;
       long long a[n];
       for(long long i=0;i<n;i++){
        cin>>a[i];
       }
       sort(a,a+n);
       int ans=0;
      for(long long i=0;i<n;i++){
        int mx=0, val=a[i];
        for(long long j=i;j<n;j++){
            if(val==a[j]){
                mx++;
                val++;
            }
           ans=max(ans,mx);
        }
      }
      cout<<ans<<endl;
 
    }
    return 0;
 
}
