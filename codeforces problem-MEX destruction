#include <bits/stdc++.h>
using namespace std;
 
int main() {
    int t;   cin>>t;
    while(t--){
      int n;   cin>>n;
      int a[n];
      for(int i=0;i<n;i++){
        cin>>a[i];
      }
      int cnt=0;
      bool flag=false;
         for(int i=0;i<n;i++){
            if(a[i]==0){
                cnt++;
            }
         }
         for(int i=0;i<n-2;i++){
            if(a[i]!=0 && a[i+1]==0 && a[i+2]!=0){
                 flag=true;
                 break;
            }
         }
 
         for(int i=0;i<n-1;i++){
            if(a[i]==0 && a[i+1]==0){
                flag=true;
                break;
            }
         }
 
         if(cnt==n){
            cout<<0<<endl;
         }
         else if(flag){
            cout<<2<<endl;
         }
         else{
            cout<<1<<endl;
         }
 
    }
        return 0;
}
