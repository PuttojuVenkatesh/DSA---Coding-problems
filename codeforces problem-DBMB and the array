#include <bits/stdc++.h>
using namespace std;
 
int main() {
    
    int t;  cin>>t;
    while(t--){
       int n,s,x;     cin>>n>>s>>x;
          int sum=0;
          int a[n];
          for(int i=0;i<n;i++){
            cin>>a[i];
            sum+=a[i];
          }
 
          bool flag=false;
          if(sum==s){
            flag=true;
          }
          else if(sum<s){
            if((s-sum)%x==0){
                flag=true;
            }
            else{
                flag=false;
            }
          }
          else if(sum>s){
            flag=false;
          }
 
          if(flag){
            cout<<"YES"<<endl;
          }
          else{
            cout<<"NO"<<endl;
          }
 
        
    }
    
 
    return 0;
}
