#include <bits/stdc++.h>
using namespace std;
 
int main() {
    int t;   cin>>t;
    while(t--){
        long long n,t;   cin>>n>>t;
       long long a[n];
             for(long long i=0;i<n;i++){
                 cin>>a[i];
             }
 
          long long cnt1=0,cnt2=0;
          for(long long i=0;i<n;i++){
            if(a[i]<t){
              cnt1++;
            }
            if(a[i]>t){
              cnt2++;
            }
          }
 
          if(cnt1>cnt2){
            cout<<t-1<<endl;
          }
          else{
            cout<<t+1<<endl;
          }
 
       
    }
        return 0;
}
