#include<bits/stdc++.h>
using namespace std;
 
int main() {
    long long t;  
    cin >> t;
    while (t--) {
        int n;  
        cin >> n;
        vector<int> v(n);  
      bool flag=true;
 
      for(int i=0;i<n;i++){
        cin>>v[i];
        if(v[i]==0){
            flag=false;
        }
      }
       
       bool ans=flag;
 
       for(int i=0;i<n;i++){
        if(v[i]==0 && v[i-1]==0){
            ans=true;
            break;
 
        }
       }
       if(ans){
        cout<<"YES"<<endl;
       }
       else{
        cout<<"NO"<<endl;
       }
       
    }
    return 0;
}
