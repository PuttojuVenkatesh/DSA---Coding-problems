#include <bits/stdc++.h>
using namespace std;
 
int main() {
   string s;   cin>>s;
   int cnt1=0, cnt2=0;
   for(int i=0;i<s.size();i++){
         if(s[i]>='a' && s[i]<='z'){
            cnt1++;
         }
         else if(s[i]>='A' && s[i]<='Z'){
            cnt2++;
         }
   }
 
   if(cnt1>=cnt2){
       for(auto &c:s){
        c=tolower(c);
       }
   }
   else{
    for(auto &c:s){
        c=toupper(c);
    }
   }
   cout<<s;
 
}
