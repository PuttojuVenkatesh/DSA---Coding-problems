#include <bits/stdc++.h>
using namespace std;
 
int main() {
    int t;   cin>>t;
    while(t--){
        int n;   cin>>n;
       long long a[n];
             for(int i=0;i<n;i++){
                 cin>>a[i];
             }
 
             sort(a,a+n);
            
             for(int i=0;i<n-1;i++){
              if(i%2==0){
                if(a[i]>a[i+1]){
                  swap(a[i],a[i+1]);
                }
              }
              else{
                if(a[i]<a[i+1]){
                  swap(a[i],a[i+1]);
                }
              }
             }
             bool flag=true;
             for(int i=0;i<n-1;i++){
              if(a[i]>a[i+1]){
                flag=false;
                break;
              }
             }
             if(flag){
              cout<<"YES"<<endl;
             }
             else{
              cout<<"NO"<<endl;
             }
       
    }
        return 0;
}
